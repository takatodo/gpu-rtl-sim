{
  "schema_version": 1,
  "gate": "tlul_fifo_sync_scaling_validation",
  "target": "tlul_fifo_sync",
  "source_boundary": {
    "baseline_commit": "f8349b9",
    "readme_fix_commit": "c041911",
    "axis_selection_commit": "dcc057d"
  },
  "preconditions": [
    "README clean-checkout build/run/compare flow passes",
    "artifacts/ and reports/ are ignored generated outputs",
    "vl_batch_gpu.meta.json reports storage_size=6016 for the current seed build"
  ],
  "runs": [
    {
      "name": "single_state_smoke",
      "nstates": 1,
      "steps": 1,
      "required": true
    },
    {
      "name": "small_batch",
      "nstates": 8,
      "steps": 1,
      "required": true
    },
    {
      "name": "medium_batch",
      "nstates": 32,
      "steps": 1,
      "required": true
    }
  ],
  "correctness_policy": {
    "single_state_aligned_cpu_gpu": "normalized_final_state_equivalence",
    "batched_gpu_runs": [
      "run exits with status 0",
      "dumped state byte size equals storage_size * nstates when dump is requested",
      "no raw-byte CPU/GPU equality claim is made for batched states"
    ]
  },
  "performance_policy": {
    "record": [
      "nstates",
      "steps",
      "elapsed_ms",
      "states_per_second"
    ],
    "non_claims": [
      "no CPU speedup claim until a CPU baseline is measured for the same nstates and steps",
      "no target-breadth claim because this gate uses only tlul_fifo_sync"
    ]
  },
  "artifacts": {
    "report": "reports/tlul_fifo_sync_scaling_validation.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "implement_tlul_fifo_sync_scaling_validation_runner",
  "next_action_on_fail": "diagnose_tlul_fifo_sync_scaling_gate_failure"
}
