{
  "schema_version": 1,
  "gate": "veer_el2_resident_patch_schedule_validation",
  "target": "veer_el2",
  "source_contract": "config/resident_patch_script_semantics.json",
  "source_launch_template": "config/slice_launch_templates/veer_el2.json",
  "purpose": "Validate the first non-TL-UL changing-input resident patch schedule path without per-step host-device patch copies.",
  "preconditions": [
    "config/scaling_gates/veer_el2_larger_resident_workload.json passes",
    "src/passes/vlgpugen emits vl_apply_patch_schedule_gpu",
    "src/hybrid/run_vl_hybrid accepts --resident-steps with --patch-script",
    "artifacts/veer_el2_obj_dir/vl_batch_gpu.cubin exists",
    "artifacts/ and reports/ are ignored generated outputs"
  ],
  "runs": [
    {
      "name": "veer_el2_resident_patch_schedule_smoke_1x6",
      "nstates": 1,
      "steps": 1,
      "resident_steps": true,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 2",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    },
    {
      "name": "veer_el2_resident_patch_schedule_batch_512x32",
      "nstates": 512,
      "steps": 1,
      "resident_steps": true,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 15",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    }
  ],
  "correctness_policy": {
    "resident_gpu_runs": [
      "run exits with status 0",
      "stdout reports resident_mode: true",
      "stdout reports resident_patch_schedule",
      "dumped state byte size equals storage_size * nstates when dump is requested"
    ],
    "non_claims": [
      "no CPU/GPU equality claim for changing-input patch schedules yet",
      "no speedup claim until a matching CPU changing-input baseline is defined",
      "byte patch offsets are validation stimuli and not a VeeR ISA/program semantics claim"
    ]
  },
  "performance_policy": {
    "record": [
      "nstates",
      "logical patch-script steps",
      "elapsed_ms",
      "state_steps_per_second"
    ],
    "non_claims": [
      "the 1x6 smoke only proves runtime wiring",
      "the 512x32 run is a non-TL-UL validation shape, not an accepted speedup claim",
      "not proof of broad VeeR family support",
      "not a full RTL application throughput claim"
    ]
  },
  "artifacts": {
    "report": "reports/veer_el2_resident_patch_schedule.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "define_veer_el2_cpu_exact_loop_resident_patch_schedule_gate",
  "next_action_on_fail": "diagnose_veer_el2_resident_patch_schedule_failure"
}
