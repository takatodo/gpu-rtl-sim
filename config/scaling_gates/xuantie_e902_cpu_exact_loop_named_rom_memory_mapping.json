{
  "schema_version": 1,
  "gate": "xuantie_e902_cpu_exact_loop_named_rom_memory_mapping",
  "target": "xuantie_e902",
  "source_gpu_gate": "config/scaling_gates/xuantie_e902_named_rom_memory_mapping.json",
  "semantic": "rom_or_memory_init_delta",
  "mapping_semantic": "named_rom_memory_symbol_mapping",
  "purpose": "Provide a matching CPU exact-loop baseline for the XuanTie-E902 named IAHB instruction-memory delta gate.",
  "preconditions": [
    "config/scaling_gates/xuantie_e902_named_rom_memory_mapping.json is defined",
    "CPU and GPU gates use the same named_patch_deltas",
    "named mapping lowering can translate case.pat word/lane deltas to root storage patch records"
  ],
  "runs": [
    {
      "name": "xuantie_e902_named_rom_memory_mapping_smoke_1x6_cpu_exact_loop",
      "nstates": 1,
      "steps": 6,
      "reset_cycles": 120,
      "post_reset_cycles": 120,
      "required": true,
      "named_patch_delta_sequence": "source_gpu_gate.named_patch_deltas"
    },
    {
      "name": "xuantie_e902_named_rom_memory_mapping_batch_128x32_cpu_exact_loop",
      "nstates": 128,
      "steps": 32,
      "reset_cycles": 120,
      "post_reset_cycles": 120,
      "required": true,
      "named_patch_delta_sequence": "source_gpu_gate.named_patch_deltas_repeated_to_32_logical_steps"
    }
  ],
  "acceptance": {
    "run_exits_zero_after_named_lowering_exists": true,
    "each_loop_reports_constructor_ok": true,
    "each_loop_root_size_matches_gpu_storage_size": true,
    "record_state_steps_per_second": true,
    "compare_against_gpu_named_mapping_report_when_present": true
  },
  "comparison_policy": {
    "allowed_claims": [
      "single-process CPU repeated eval_step wall time with the same named IAHB instruction-memory delta schedule",
      "GPU resident patch schedule throughput for the same named mapping gate shape",
      "CPU/GPU state-step throughput ratio for this bounded named mapping gate"
    ],
    "non_claims": [
      "not proof of broad XuanTie family support",
      "not a full RTL application throughput claim",
      "not ISA/program correctness",
      "not full software boot correctness"
    ]
  },
  "artifacts": {
    "report": "reports/xuantie_e902_cpu_exact_loop_named_rom_memory_mapping.json",
    "generated_outputs_only": true
  },
  "next_action_on_defined": "implement_xuantie_e902_named_rom_memory_mapping_lowering",
  "next_action_on_fail": "diagnose_xuantie_e902_cpu_named_rom_memory_mapping_failure"
}
