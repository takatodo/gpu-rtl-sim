{
  "schema_version": 1,
  "gate": "xuantie_e902_cpu_exact_loop_rom_memory_delta_patch_schedule",
  "target": "xuantie_e902",
  "source_gpu_gate": "config/scaling_gates/xuantie_e902_rom_memory_delta_patch_schedule.json",
  "semantic": "rom_or_memory_init_delta",
  "purpose": "Provide a matching CPU exact-loop baseline for the XuanTie-E902 ROM or memory initialization delta resident patch schedule gate.",
  "preconditions": [
    "reports/xuantie_e902_rom_memory_delta_patch_schedule.json exists",
    "artifacts/xuantie_e902_obj_dir/xuantie_e902_host_probe exists",
    "CPU and GPU gates use the same patch_script_lines delta sequence"
  ],
  "runs": [
    {
      "name": "xuantie_e902_rom_memory_delta_smoke_1x6_cpu_exact_loop",
      "nstates": 1,
      "steps": 6,
      "reset_cycles": 120,
      "post_reset_cycles": 120,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 2",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    },
    {
      "name": "xuantie_e902_rom_memory_delta_batch_128x32_cpu_exact_loop",
      "nstates": 128,
      "steps": 32,
      "reset_cycles": 120,
      "post_reset_cycles": 120,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 15",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    }
  ],
  "acceptance": {
    "run_exits_zero": true,
    "each_loop_reports_constructor_ok": true,
    "each_loop_root_size_matches_gpu_storage_size": true,
    "record_state_steps_per_second": true,
    "compare_against_gpu_patch_schedule_report_when_present": true
  },
  "comparison_policy": {
    "allowed_claims": [
      "single-process CPU repeated eval_step wall time with the same ROM or memory delta schedule",
      "GPU resident patch schedule throughput for the same bounded semantic gate shape",
      "CPU/GPU state-step throughput ratio for this bounded ROM or memory delta proxy gate"
    ],
    "non_claims": [
      "not proof of broad XuanTie family support",
      "not a full RTL application throughput claim",
      "not ISA/program correctness",
      "the first gate uses explicit storage offsets as a proxy mapping for ROM or memory deltas"
    ]
  },
  "artifacts": {
    "report": "reports/xuantie_e902_cpu_exact_loop_rom_memory_delta_patch_schedule.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "run_xuantie_e902_rom_memory_delta_gpu_cpu_comparison",
  "next_action_on_fail": "diagnose_xuantie_e902_cpu_rom_memory_delta_patch_schedule_failure"
}
