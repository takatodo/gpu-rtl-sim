{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpu-rtl-sim/tlul10818_boundary_run_spec.schema.json",
  "title": "TL-UL #10818 external boundary run spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "finite_axis_values",
    "backends",
    "trials",
    "comparisons"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "finite_axis_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backpressure_cycles", "response_delay_cycles"],
      "properties": {
        "backpressure_cycles": {"$ref": "#/$defs/ordered_cycle_values"},
        "response_delay_cycles": {"$ref": "#/$defs/ordered_cycle_values"}
      }
    },
    "backends": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/backend"}
    },
    "trials": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/trial"}
    },
    "comparisons": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/comparison"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ordered_cycle_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "kind", "executor_identity", "resident_width"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["cpu", "gpu"]},
        "executor_identity": {"type": "string", "minLength": 1},
        "resident_width": {"type": "integer", "minimum": 1}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "backend_id",
        "policy",
        "requested_count",
        "budget_logical_bad_queries"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "backend_id": {"type": "string", "minLength": 1},
        "policy": {"$ref": "#/$defs/policy"},
        "requested_count": {"type": "integer", "minimum": 1},
        "budget_logical_bad_queries": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "algorithm_version", "seed_sha256", "configuration"],
      "properties": {
        "kind": {
          "enum": [
            "random",
            "stratified",
            "ordered_refinement",
            "novelty_boundary_guided"
          ]
        },
        "algorithm_version": {"type": "integer", "const": 1},
        "seed_sha256": {"$ref": "#/$defs/sha256"},
        "configuration": {"type": "object"}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "random"},
            "configuration": {"$ref": "#/$defs/empty_configuration"}
          }
        },
        {
          "properties": {
            "kind": {"const": "stratified"},
            "configuration": {"$ref": "#/$defs/stratified_configuration"}
          }
        },
        {
          "properties": {
            "kind": {"const": "ordered_refinement"},
            "configuration": {"$ref": "#/$defs/refinement_configuration"}
          }
        },
        {
          "properties": {
            "kind": {"const": "novelty_boundary_guided"},
            "configuration": {"$ref": "#/$defs/empty_configuration"}
          }
        }
      ]
    },
    "empty_configuration": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "stratified_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strata_axes"],
      "properties": {
        "strata_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "refinement_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis"],
      "properties": {
        "axis": {"type": "string", "minLength": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "kind", "trial_ids"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["selector", "backend"]},
        "trial_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
