{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpu-rtl-sim/tlul10818_boundary_timing_template.schema.json",
  "title": "TL-UL #10818 boundary timing template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "experiment_id",
    "sweep_space_sha256",
    "action_domain_sha256",
    "timing_rows"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "tlul10818_boundary_timing_template"},
    "experiment_id": {"type": "string", "minLength": 1},
    "sweep_space_sha256": {"$ref": "#/$defs/sha256"},
    "action_domain_sha256": {"$ref": "#/$defs/sha256"},
    "timing_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/timing_row"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point_id": {"type": "string", "pattern": "^point:v1:[0-9a-f]{64}$"},
    "execution_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "revision",
        "purpose",
        "epoch_index"
      ],
      "properties": {
        "point_id": {"$ref": "#/$defs/point_id"},
        "revision": {"enum": ["bad", "fixed"]},
        "purpose": {"enum": ["bad_search", "fixed_confirmation"]},
        "epoch_index": {"type": "integer", "minimum": 0}
      }
    },
    "timing_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "launch_index",
        "backend_id",
        "resident_width",
        "execution_requests",
        "runner_must_fill"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "launch_index": {"type": "integer", "minimum": 0},
        "backend_id": {"type": "string", "minLength": 1},
        "resident_width": {"type": "integer", "minimum": 1},
        "execution_requests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/execution_request"}
        },
        "runner_must_fill": {
          "type": "array",
          "prefixItems": [
            {"const": "cycle_evals"},
            {"const": "start_offset_ns"},
            {"const": "end_offset_ns"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
