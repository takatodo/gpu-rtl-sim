+        // --sim-accel sidecar-gpu: emit a Makefile rule that validates the
+        // known closure, builds the adjacent GPU artifact, and links a
+        // repo-owned direct CUDA smoke shim into the generated executable.
+        // Verilator itself never launches the sidecar runtime here; it only
+        // emits the rule.
+        // Fails closed for unsupported or incomplete sidecar requests.
+        string sidecarExeDeps;
+        string sidecarExeLibs;
+        if (!v3Global.opt.simAccel().empty()) {
+            if (v3Global.opt.simAccel() != "sidecar-gpu") {
+                v3fatal("--sim-accel only supports 'sidecar-gpu' for the Makefile build hook");
+            } else if (!v3Global.opt.exe()) {
+                v3fatal("--sim-accel sidecar-gpu requires --exe to emit the sidecar build hook");
+            } else if (v3Global.opt.topModule().empty()) {
+                v3fatal("--sim-accel sidecar-gpu requires --top-module for the sidecar build hook");
+            } else if (v3Global.opt.simAccelFilelist().empty()) {
+                v3fatal("--sim-accel sidecar-gpu requires a -f filelist for the sidecar build hook");
+            } else if (v3Global.opt.simAccelStates() <= 0 || v3Global.opt.simAccelSteps() <= 0) {
+                v3fatal("--sim-accel sidecar-gpu requires positive --sim-accel-states and "
+                        "--sim-accel-steps");
+            } else {
+                of.puts("\n### Sidecar GPU build hook... (from --sim-accel sidecar-gpu)\n");
+                of.puts("PYTHON3 ?= python3\n");
+                of.puts("VL_SIDECAR_REPO_ROOT ?= $(if $(RTLMETER_REPO_ROOT),$(abspath $(RTLMETER_REPO_ROOT)),$(abspath $(firstword $(VM_USER_DIR))))\n");
+                of.puts("VL_SIDECAR_STAMP = $(VM_PREFIX)__sidecar_build.stamp\n");
+                of.puts("VL_SIDECAR_SHIM_SRC = "
+                        "$(VL_SIDECAR_REPO_ROOT)/src/hybrid/native_sidecar_shim.c\n");
+                of.puts("VL_SIDECAR_SHIM_OBJ = $(VM_PREFIX)__native_sidecar_shim.o\n");
+                of.puts("$(VL_SIDECAR_SHIM_OBJ): $(VL_SIDECAR_SHIM_SRC) $(VL_SIDECAR_STAMP)\n");
+                of.puts("\t$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(OPT_FAST) "
+                        + compilerIncludeFlag
+                        + " -DGPU_RTL_SIM_REPO_ROOT_DEFAULT=\\\"$(VL_SIDECAR_REPO_ROOT)\\\""
+                        + " -c -o $@ $<\n");
+                of.puts("$(VL_SIDECAR_STAMP): $(VK_GLOBAL_OBJS) $(VM_PREFIX)__ALL.a\n");
+                // The driver validates the recognized closure, builds adjacent
+                // vl_batch_gpu.meta.json / vl_batch_gpu.cubin files, and rejects
+                // known-unsupported artifact shapes before link. The linked shim
+                // dynamically resolves the CUDA Driver API and attempts module
+                // load + kernel launch at runtime.
+                of.puts("\t$(PYTHON3) "
+                        "$(VL_SIDECAR_REPO_ROOT)/src/tools/verilator_native_sidecar_make_driver.py "
+                        "build-direct-shim-smoke \\\n");
+                of.puts("\t  --repo-root $(VL_SIDECAR_REPO_ROOT) \\\n");
+                of.puts("\t  --filelist $(abspath $(firstword $(VM_USER_DIR))/"
+                        + v3Global.opt.simAccelFilelist() + ") \\\n");
+                of.puts("\t  --top-module " + v3Global.opt.topModule() + " \\\n");
+                of.puts("\t  --mdir . \\\n");
+                of.puts("\t  --sim-accel sidecar-gpu \\\n");
+                of.puts("\t  --sim-accel-states " + std::to_string(v3Global.opt.simAccelStates())
+                        + " \\\n");
+                of.puts("\t  --sim-accel-steps " + std::to_string(v3Global.opt.simAccelSteps())
+                        + " \\\n");
+                of.puts("\t  --summary-out native_sidecar_build.json\n");
+                of.puts("\ttouch $@\n");
+                of.puts("\n");
+                // Normal prerequisite: the shim object must enter the final link
+                // inputs ($^) so obj_dir/V<top> reaches repo-owned sidecar code.
+                // The stamp remains make-time metadata only and is not linked.
+                sidecarExeDeps = " $(VL_SIDECAR_SHIM_OBJ)";
+                sidecarExeLibs = " -ldl";
+            }
+        }
+
         if (v3Global.opt.exe()) {
             of.puts("\n### Link rules... (from --exe)\n");
             // '{prefix}__ALL.a', contains all hierarchical libraries
             of.puts(v3Global.opt.exeName()
