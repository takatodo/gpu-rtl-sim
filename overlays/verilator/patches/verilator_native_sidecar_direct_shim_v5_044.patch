     const auto callStrSetter = [this](void (V3Options::*cbStr)(const string&)) {
         return [this, cbStr](const string& v) { (this->*cbStr)(v); };
     };
+    const auto parsePositiveSimAccelCount = [fl](const char* optp, const char* valp) {
+        const char* const textp = valp ? valp : "";
+        bool valid = textp[0] != '\0';
+        int val = 0;
+        for (const char* cp = textp; valid && *cp; ++cp) {
+            if (!std::isdigit(static_cast<unsigned char>(*cp))) {
+                valid = false;
+                break;
+            }
+            const int digit = *cp - '0';
+            if (val > 214748364 || (val == 214748364 && digit > 7)) {
+                valid = false;
+                break;
+            }
+            val = (val * 10) + digit;
+        }
+        if (!valid || val <= 0) {
+            fl->v3error(optp << " requires a positive integer, but '" << textp << "' was passed");
+            val = 1;
+        }
+        return val;
+    };
