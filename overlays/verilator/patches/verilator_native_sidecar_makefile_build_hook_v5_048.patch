--- a/src/V3Options.cpp
+++ b/src/V3Options.cpp
@@ -1463,6 +1463,10 @@ void V3Options::parseOptsList(FileLine* fl, const string& optdir, int argc,
     DECL_OPTION("-FI", CbVal,
                 [this, &optdir](const char* valp) { addForceInc(parseFileArg(optdir, valp)); });
     DECL_OPTION("-f", CbVal, [this, fl, &optdir](const char* valp) VL_MT_DISABLED {
+        // Preserve the original -f filelist path so the sidecar Makefile hook can
+        // hand it to the repo-side known-closure build driver. Parsing behavior is
+        // unchanged; this only records metadata.
+        m_simAccelFilelist = parseFileArg(optdir, valp);
         parseOptsFile(fl, parseFileArg(optdir, valp), false);
     }).notForRerun();
     DECL_OPTION("-flatten", OnOff, &m_flatten);
