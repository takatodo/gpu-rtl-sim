{
  "schema_version": 1,
  "gate": "neural_network_style_prim_generic_and2_larger_resident_steps",
  "target": "prim_generic_and2",
  "purpose": "Define a larger same-target NN-style runtime workload after the resident_steps review passed.",
  "prior_review": "neural_network_style_resident_steps_review",
  "optimization_knob": {
    "name": "resident_steps",
    "baseline_value": false,
    "candidate_value": true,
    "reason": "Keep the target fixed and increase nstates/steps before making broader resident-step performance claims."
  },
  "preconditions": [
    "neural_network_style_resident_steps_review passed",
    "prim_generic_and2 Verilator obj_dir is generated",
    "prim_generic_and2 GPU cubin is built",
    "reports/neural_network_style_prim_generic_and2_baseline.json exists",
    "reports/neural_network_style_prim_generic_and2_resident_steps.json exists"
  ],
  "runs": [
    {
      "name": "baseline_steps_4_batch_1024",
      "nstates": 1024,
      "steps": 4,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "resident_steps_4_batch_1024",
      "nstates": 1024,
      "steps": 4,
      "resident_steps": true,
      "required": true
    },
    {
      "name": "baseline_steps_16_batch_1024",
      "nstates": 1024,
      "steps": 16,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "resident_steps_16_batch_1024",
      "nstates": 1024,
      "steps": 16,
      "resident_steps": true,
      "required": true
    }
  ],
  "comparison_policy": {
    "paired_runs": [
      [
        "baseline_steps_4_batch_1024",
        "resident_steps_4_batch_1024"
      ],
      [
        "baseline_steps_16_batch_1024",
        "resident_steps_16_batch_1024"
      ]
    ],
    "same_target_required": true,
    "same_nstates_and_steps_required": true,
    "record_delta_after_run": true
  },
  "correctness_policy": {
    "batched_gpu_runs": [
      "run exits with status 0",
      "dumped state byte size equals storage_size * nstates when dump is requested",
      "the generated zero-initialized GPU dumps are runtime evidence only"
    ],
    "non_claims": [
      "not resident_steps general speedup",
      "not neural-network numerical correctness",
      "not model accuracy or convergence",
      "not model speedup",
      "not training throughput",
      "not inference framework integration",
      "not GEMM or tensor-core kernel implementation",
      "not raw full-state equality",
      "not zero-initialized GPU correctness",
      "not RAM/ROM/XPM behavior",
      "not Xilinx wrapper behavior beyond existing scoped gates"
    ]
  },
  "performance_policy": {
    "record": [
      "nstates",
      "steps",
      "resident_steps",
      "elapsed_ms",
      "states_per_second"
    ],
    "non_claims": [
      "single-target larger-workload measurement only",
      "no general CUDA portability claim",
      "no CPU speedup claim",
      "no neural-network model speedup claim"
    ]
  },
  "artifacts": {
    "report": "reports/neural_network_style_prim_generic_and2_larger_resident_steps.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "record_larger_neural_network_style_runtime_workload_result",
  "next_action_on_fail": "diagnose_larger_neural_network_style_runtime_workload_gate"
}
