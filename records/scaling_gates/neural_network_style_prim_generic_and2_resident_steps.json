{
  "schema_version": 1,
  "gate": "neural_network_style_prim_generic_and2_resident_steps",
  "target": "prim_generic_and2",
  "purpose": "Compare resident-step GPU runtime throughput against the NN-style prim_generic_and2 baseline without changing correctness scope.",
  "baseline_report": "reports/neural_network_style_prim_generic_and2_baseline.json",
  "optimization_knob": {
    "name": "resident_steps",
    "baseline_value": false,
    "candidate_value": true,
    "reason": "Exercise the existing resident-step runtime path for repeated NN-style many-state execution."
  },
  "preconditions": [
    "prim_generic_and2 Verilator obj_dir is generated",
    "prim_generic_and2 GPU cubin is built",
    "reports/neural_network_style_prim_generic_and2_baseline.json exists",
    "reports/prim_generic_and2_source_gate.json and reports/prim_generic_and2_coverage_output_depth.json preserve correctness evidence"
  ],
  "runs": [
    {
      "name": "resident_steps_1_batch_32",
      "nstates": 32,
      "steps": 1,
      "resident_steps": true,
      "required": true
    },
    {
      "name": "resident_steps_4_batch_32",
      "nstates": 32,
      "steps": 4,
      "resident_steps": true,
      "required": true
    }
  ],
  "correctness_policy": {
    "batched_gpu_runs": [
      "run exits with status 0",
      "dumped state byte size equals storage_size * nstates when dump is requested",
      "the generated zero-initialized GPU dumps are runtime evidence only"
    ],
    "non_claims": [
      "not neural-network numerical correctness",
      "not model accuracy or convergence",
      "not training throughput",
      "not inference framework integration",
      "not GEMM or tensor-core kernel implementation",
      "not raw full-state equality",
      "not zero-initialized GPU correctness",
      "not RAM/ROM/XPM behavior",
      "not Xilinx wrapper behavior beyond existing scoped gates"
    ]
  },
  "performance_policy": {
    "record": [
      "nstates",
      "steps",
      "resident_steps",
      "elapsed_ms",
      "states_per_second"
    ],
    "non_claims": [
      "single-target measurement only",
      "no general CUDA portability claim",
      "no CPU speedup claim",
      "no neural-network model speedup claim"
    ]
  },
  "artifacts": {
    "report": "reports/neural_network_style_prim_generic_and2_resident_steps.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "record_neural_network_style_optimization_result",
  "next_action_on_fail": "diagnose_neural_network_style_resident_steps_regression"
}
