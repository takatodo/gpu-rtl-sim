{
  "schema_version": 1,
  "gate": "neural_network_style_tlul_fifo_sync_in_process_gpu_event_timing_repeat_noise_floor",
  "target": "tlul_fifo_sync",
  "purpose": "Capture repeated GPU-event timing samples inside one run_vl_hybrid process after round-based same-artifact captures still showed outliers.",
  "prior_review": "round_based_gpu_event_timing_noise_floor_result_review",
  "measurement_stability_policy": "nn_style_runtime_measurement_stability_policy",
  "claim_scope": "in-process repeated GPU-event timing capture for tlul_fifo_sync default ptxas and ptxas_opt_level=0 cubins at 512 states x 32 steps with zero-init, no patches, and resident_steps=false only",
  "optimization_knob": {
    "name": "in_process_gpu_event_timing_repeat_capture",
    "baseline_value": "single_process_gpu_event_samples",
    "candidate_value": "median_of_in_process_gpu_event_samples",
    "reason": "Round-based out-of-process captures still had a large same-artifact outlier. Repeating CUDA-event samples inside one process gives min/median/max without adding another broad target or optimization knob."
  },
  "preconditions": [
    "round_based_gpu_event_timing_noise_floor_result_review passed",
    "run_vl_hybrid supports RUN_VL_HYBRID_TIMING_REPEATS",
    "src/tools/run_vl_hybrid.py forwards --timing-repeats",
    "src/tools/run_tlul_fifo_sync_scaling_validation.py records gpu_event_timing_repeat fields",
    "tlul_fifo_sync is already in active_scope.targets",
    "tlul_fifo_sync Verilator obj_dir is generated",
    "tlul_fifo_sync GPU PTX exists",
    "resident_steps is disabled for all runs",
    "runs use zero-init and no patch script"
  ],
  "builds": [
    {
      "name": "ptxas_default",
      "ptxas_opt_level": null,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --out artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_gpu_event_repeat_ptxas_default.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_gpu_event_repeat_ptxas_default.cubin",
      "required": true
    },
    {
      "name": "ptxas_o0",
      "ptxas_opt_level": 0,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --ptxas-opt-level 0 --out artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_gpu_event_repeat_ptxas_o0.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_gpu_event_repeat_ptxas_o0.cubin",
      "required": true
    }
  ],
  "runs": [
    {
      "name": "warmup_default_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 1,
      "role": "warmup",
      "required": true
    },
    {
      "name": "warmup_o0_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 1,
      "role": "warmup",
      "required": true
    },
    {
      "name": "default_in_process_repeat_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "required": true
    },
    {
      "name": "o0_in_process_repeat_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "required": true
    }
  ],
  "comparison_policy": {
    "comparison_type": "in_process_repeated_gpu_event_timing_noise_floor",
    "primary_metric": "gpu_event_timing_repeat.total_ms_median",
    "warmup_runs": 2,
    "measured_runs": 2,
    "required_repeat_count": 9,
    "required_timing_fields": [
      "gpu_kernel_time_ms_total",
      "gpu_kernel_time_ms_per_launch",
      "gpu_kernel_time_us_per_state",
      "gpu_kernel_time_repeat_count",
      "gpu_kernel_time_ms_total_min",
      "gpu_kernel_time_ms_total_median",
      "gpu_kernel_time_ms_total_max",
      "gpu_kernel_time_ms_total_samples"
    ],
    "unsupported_with_timing_repeats": [
      "patch_script",
      "init_state",
      "resident_steps"
    ]
  },
  "acceptance_policy": {
    "all_required_builds_pass": true,
    "all_required_runs_pass": true,
    "measured_runs_have_gpu_event_timing_repeat": true,
    "required_repeat_count": 9,
    "review_before_next_optimization_comparison": true,
    "speedup_claim_allowed": false
  },
  "correctness_policy": {
    "required": true,
    "expected_dump_bytes": "storage_size * nstates",
    "required_run_status": "ok",
    "non_claims": [
      "not_full_state_equivalence",
      "not_cpu_exactness_claim",
      "not_zero_init_general_correctness_claim"
    ]
  },
  "performance_policy": {
    "primary_metric": "gpu_event_timing_repeat.total_ms_median",
    "required_timing_fields": [
      "gpu_kernel_time_ms_total",
      "gpu_kernel_time_ms_per_launch",
      "gpu_kernel_time_us_per_state",
      "gpu_kernel_time_repeat_count",
      "gpu_kernel_time_ms_total_min",
      "gpu_kernel_time_ms_total_median",
      "gpu_kernel_time_ms_total_max",
      "gpu_kernel_time_ms_total_samples"
    ],
    "required_repeat_count": 9,
    "decision_rule": "record min/median/max and samples; do not claim speedup unless a later review accepts stable repeat medians against the measurement stability policy",
    "non_claims": [
      "not_optimization_speedup_claim",
      "not_ptxas_opt_level_speedup_claim",
      "not_stable_speedup_or_regression_claim",
      "not_mean_only_speedup_claim",
      "not_compiler_knob_generalization",
      "not_target_breadth_performance_generalization",
      "not_resident_steps_fix_or_general_speedup",
      "not_neural_network_model_or_training_or_inference_throughput_claim",
      "not_cpu_speedup_claim",
      "not_general_cuda_portability_claim",
      "not_full_runtime_semantic_equivalence_for_repeated_samples"
    ]
  }
}
