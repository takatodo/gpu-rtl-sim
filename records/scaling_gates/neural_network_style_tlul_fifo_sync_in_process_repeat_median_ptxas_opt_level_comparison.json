      "required": true
    }
  ],
  "comparison_policy": {
    "comparison_type": "in_process_repeat_median_ptxas_opt_level_comparison",
    "primary_metric": "gpu_event_timing_repeat.total_ms_median",
    "baseline": "ptxas_default",
    "candidate": "ptxas_opt_level_0",
    "warmup_runs": 2,
    "measured_runs": 6,
    "comparison_pair_count": 3,
    "required_repeat_count": 9,
    "speedup_acceptance_thresholds": {
      "all_pair_deltas_positive": true,
