      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "comparison_pair": "pair_1",
      "variant": "baseline",
      "required": true
    },
    {
      "name": "pair_1_o0_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "comparison_pair": "pair_1",
      "variant": "candidate",
      "required": true
    },
    {
      "name": "pair_2_o0_steps_32_batch_512",
