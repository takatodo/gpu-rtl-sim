    "review_before_speedup_claim": true,
    "speedup_claim_allowed_by_gate_alone": false
  },
  "correctness_policy": {
    "required": true,
    "expected_dump_bytes": "storage_size * nstates",
    "required_run_status": "ok",
    "non_claims": [
