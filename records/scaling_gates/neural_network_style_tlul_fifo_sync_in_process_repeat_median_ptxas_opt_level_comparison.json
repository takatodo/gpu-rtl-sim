{
  "schema_version": 1,
  "gate": "neural_network_style_tlul_fifo_sync_in_process_repeat_median_ptxas_opt_level_comparison",
  "target": "tlul_fifo_sync",
  "purpose": "Re-compare ptxas default versus ptxas_opt_level=0 using in-process repeat-median GPU-event timing after the multi-pair same-artifact noise floor was bounded below 2%.",
  "prior_review": "multi_pair_in_process_repeat_median_noise_floor_result_review",
  "measurement_stability_policy": "nn_style_runtime_measurement_stability_policy",
  "claim_scope": "narrow tlul_fifo_sync ptxas default versus ptxas_opt_level=0 comparison at 512 states x 32 steps using in-process repeat-median GPU-event timing only",
  "optimization_knob": {
    "name": "ptxas_opt_level",
    "baseline_value": "ptxas_default",
    "candidate_value": "ptxas_opt_level_0",
    "reason": "Earlier ptxas comparisons were too noisy. The multi-pair same-artifact in-process repeat-median noise floor now has max 1.27%, so a narrow repeat-median ptxas comparison can be re-run."
  },
  "preconditions": [
    "multi_pair_in_process_repeat_median_noise_floor_result_review passed",
    "same-artifact repeat-median max delta is below 2%",
    "run_vl_hybrid supports RUN_VL_HYBRID_TIMING_REPEATS",
    "src/tools/run_vl_hybrid.py forwards --timing-repeats",
    "src/tools/run_tlul_fifo_sync_scaling_validation.py records gpu_event_timing_repeat fields",
    "tlul_fifo_sync Verilator obj_dir is generated",
    "tlul_fifo_sync GPU PTX exists",
    "resident_steps is disabled for all runs",
    "runs use zero-init and no patch script"
  ],
  "builds": [
    {
      "name": "ptxas_default",
      "ptxas_opt_level": null,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --out artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_repeat_median_ptxas_default.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_repeat_median_ptxas_default.cubin",
      "required": true
    },
    {
      "name": "ptxas_o0",
      "ptxas_opt_level": 0,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --ptxas-opt-level 0 --out artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_repeat_median_ptxas_o0.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_in_process_repeat_median_ptxas_o0.cubin",
      "required": true
    }
  ],
  "runs": [
    {
      "name": "warmup_default_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 1,
      "role": "warmup",
      "required": true
    },
    {
      "name": "warmup_o0_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 1,
      "role": "warmup",
      "required": true
    },
    {
