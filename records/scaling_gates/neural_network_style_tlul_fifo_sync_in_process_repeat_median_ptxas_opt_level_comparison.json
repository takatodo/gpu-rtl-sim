      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "comparison_pair": "pair_2",
      "variant": "candidate",
      "required": true
    },
    {
      "name": "pair_2_default_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "timing_repeats": 9,
      "role": "measured",
      "comparison_pair": "pair_2",
      "variant": "baseline",
      "required": true
    },
    {
      "name": "pair_3_default_steps_32_batch_512",
