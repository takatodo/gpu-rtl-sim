{
  "schema_version": 1,
  "gate": "neural_network_style_tlul_fifo_sync_ptxas_opt_level_policy_repeat",
  "target": "tlul_fifo_sync",
  "purpose": "Run a policy-compliant ptxas_opt_level repeat comparison with at least three paired repeats before making any stable speedup claim.",
  "prior_review": "ptxas_opt_level_repeat_noise_check_mixed_result_review",
  "measurement_stability_policy": "nn_style_runtime_measurement_stability_policy",
  "claim_scope": "policy-compliant repeat check for tlul_fifo_sync default ptxas versus ptxas_opt_level=0 at 512 states x 32 steps with resident_steps=false only",
  "optimization_knob": {
    "name": "ptxas_opt_level",
    "baseline_value": null,
    "candidate_value": 0,
    "reason": "Repeat the same noisy ptxas comparison under the measurement stability policy before selecting another knob or broadening to another target."
  },
  "preconditions": [
    "ptxas_opt_level_repeat_noise_check_mixed_result_review passed",
    "nn_style_runtime_measurement_stability_policy is defined",
    "tlul_fifo_sync is already in active_scope.targets",
    "tlul_fifo_sync Verilator obj_dir is generated",
    "tlul_fifo_sync GPU PTX exists",
    "resident_steps is disabled for all comparison runs",
    "existing tlul_fifo_sync source/depth gates preserve correctness evidence"
  ],
  "builds": [
    {
      "name": "ptxas_default",
      "ptxas_opt_level": null,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --out artifacts/tlul_fifo_sync_obj_dir/nn_style_policy_ptxas_default.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_policy_ptxas_default.cubin",
      "required": true
    },
    {
      "name": "ptxas_o0",
      "ptxas_opt_level": 0,
      "command": "PYTHONPATH=src/tools python3 src/tools/build_vl_gpu.py artifacts/tlul_fifo_sync_obj_dir --reuse-ptx --ptxas-opt-level 0 --out artifacts/tlul_fifo_sync_obj_dir/nn_style_policy_ptxas_o0.cubin",
      "cubin": "artifacts/tlul_fifo_sync_obj_dir/nn_style_policy_ptxas_o0.cubin",
      "required": true
    }
  ],
  "runs": [
    {
      "name": "ptxas_default_policy_repeat_1_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "ptxas_o0_policy_repeat_1_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "ptxas_default_policy_repeat_2_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "ptxas_o0_policy_repeat_2_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "ptxas_default_policy_repeat_3_steps_32_batch_512",
      "build": "ptxas_default",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    },
    {
      "name": "ptxas_o0_policy_repeat_3_steps_32_batch_512",
      "build": "ptxas_o0",
      "nstates": 512,
      "steps": 32,
      "resident_steps": false,
      "required": true
    }
  ],
  "comparison_policy": {
    "minimum_repetitions_per_variant": 3,
    "paired_runs": [
      [
        "ptxas_default_policy_repeat_1_steps_32_batch_512",
        "ptxas_o0_policy_repeat_1_steps_32_batch_512"
      ],
      [
        "ptxas_default_policy_repeat_2_steps_32_batch_512",
        "ptxas_o0_policy_repeat_2_steps_32_batch_512"
      ],
      [
        "ptxas_default_policy_repeat_3_steps_32_batch_512",
        "ptxas_o0_policy_repeat_3_steps_32_batch_512"
      ]
    ],
    "same_target_required": true,
    "same_nstates_and_steps_required": true,
    "resident_steps_must_be_false": true,
    "mean_delta_alone_must_not_support_speedup_claim": true,
    "stable_speedup_requirements": [
      "all required builds pass",
      "all required runs pass",
      "all dump byte counts match expected byte counts when dumps are requested",
      "all paired candidate deltas are positive",
      "median paired delta is at least +5.0 percent",
      "minimum paired delta is at least +2.0 percent"
    ],
    "record_delta_after_run": true
  },
  "correctness_policy": {
    "batched_gpu_runs": [
      "run exits with status 0",
      "dumped state byte size equals storage_size * nstates when dump is requested",
      "the generated zero-initialized GPU dumps are runtime evidence only"
    ],
    "non_claims": [
      "not mean-only speedup claim",
      "not stable speedup when paired deltas disagree",
      "not stable ptxas_opt_level speedup from the prior repeat result",
      "not ptxas_opt_level general speedup",
      "not target-breadth performance generalization",
      "not compiler-knob generalization",
      "not resident_steps fix",
      "not resident_steps general speedup",
      "not neural-network numerical correctness",
      "not model speedup",
      "not training or inference throughput",
      "not GEMM or tensor-core kernel performance",
      "not raw full-state equality",
      "not zero-initialized GPU correctness",
      "not CPU speedup claim",
      "not general CUDA performance portability"
    ]
  },
  "performance_policy": {
    "record": [
      "target",
      "optimization_knob",
      "baseline_value",
      "candidate_value",
      "nstates",
      "steps",
      "resident_steps",
      "storage_size",
      "ptxas_opt_level",
      "elapsed_ms",
      "states_per_second",
      "dump_bytes",
      "expected_dump_bytes",
      "paired_delta_percent",
      "paired_deltas_percent",
      "median_delta_percent",
      "min_delta_percent",
      "max_delta_percent",
      "positive_pair_count",
      "negative_pair_count",
      "stable_speedup_decision"
    ],
    "non_claims": [
      "policy-compliant repeat check only",
      "single-target compiler-backend knob measurement only",
      "no target-breadth performance generalization",
      "no general CUDA portability claim",
      "no CPU speedup claim",
      "no neural-network model speedup claim"
    ]
  },
  "artifacts": {
    "report": "reports/neural_network_style_tlul_fifo_sync_ptxas_opt_level_policy_repeat.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "run_policy_compliant_nn_style_runtime_repeat_gate",
  "next_action_on_fail": "diagnose_policy_compliant_nn_style_runtime_repeat_gate_definition"
}
