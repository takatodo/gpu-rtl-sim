    {
      "target": "prim_clock_gating",
      "reason": "clock-gating latch behavior is clock-special and remains outside the current primitive claim"
    },
    {
      "target": "prim_diff_decode",
      "reason": "differential decode reaches alert/esc signal-integrity behavior and async skew handling; take a narrower arbitration-policy primitive first"
    },
    {
      "target": "alert_or_esc_primitives",
      "reason": "alert and escalation primitives introduce protocol breadth beyond the next single primitive gate"
    },
    {
      "target": "full_ip_blocks",
