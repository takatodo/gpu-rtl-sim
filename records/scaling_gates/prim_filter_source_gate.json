  "weakest_point": "The twenty-second primitive boundary covers a strict onehot checker, but the active primitive set still has no direct input-filter claim. A prim_filter gate can target the synchronous four-cycle filter path while keeping AsyncOn=1 synchronizer behavior, all cycle counts, metastability/CDC correctness, raw full-state equality, and zero-initialized GPU correctness outside the claim.",
  "why_this_target": [
    "the twenty-second primitive review accepted prim_onehot_check while leaving input filtering outside the active claim",
    "prim_filter is a small source-backed stateful primitive with observable stored-value and bypass behavior",
    "fixing AsyncOn=0 keeps the next gate narrower than differential alert/esc signaling and broader CDC claims",
    "Cycles=4 gives meaningful history-dependent behavior without introducing a new large dependency family",
    "it adds more claim value than standalone buffer wrappers and less policy breadth than arbiter-tree or memory primitives"
  ],
  "rejected_for_now": [
    {
      "target": "prim_diff_decode",
      "reason": "differential decode reaches alert/esc signal-integrity behavior and async skew handling; defer until one more small synchronous stateful primitive passes"
    },
    {
      "target": "prim_arbiter_tree_or_ppc",
      "reason": "broader arbiter families add larger arbitration policy breadth immediately after prim_arbiter_fixed and the onehot checker"
    },
    {
      "target": "prim_clock_mux2_or_clock_gating_sync",
      "reason": "additional clock-special primitives add less claim diversity immediately after prim_clock_gating"
    },
    {
      "target": "prim_sec_anchor_buf",
      "reason": "standalone buffer wrapper is too small and is already exercised indirectly through active life-cycle and MuBi dependency paths"
    },
    {
      "target": "full_ip_blocks",
      "reason": "full IP blocks remain too large for the next narrow source-backed primitive gate"
    }
  ],
