      "target": "prim_arbiter_tree_or_ppc",
      "reason": "broader arbiter families add larger stateful arbitration policy breadth immediately after prim_arbiter_fixed"
    },
    {
      "target": "prim_clock_mux2_or_clock_gating_sync",
      "reason": "another clock-special primitive immediately after prim_clock_gating adds less claim diversity than a onehot checker"
    },
    {
      "target": "prim_sec_anchor_buf",
      "reason": "standalone buffer wrapper is too small and lower value than a checker with observable error behavior"
    },
