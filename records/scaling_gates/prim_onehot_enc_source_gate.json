  "weakest_point": "The current active primitive set includes prim_onehot_check and indirect prim_onehot_enc exposure through TL-UL RACL, but still has no direct primitive-level onehot encoder claim. A prim_onehot_enc gate can target OneHotWidth=8 while keeping all widths, downstream mux/assertion policy, raw full-state equality, zero-initialized GPU correctness, and full primitive-family support outside the claim.",
  "why_this_target": [
    "complements active prim_onehot_check with the encoder half of the onehot family",
    "is a 21-line source-backed combinational primitive with no new package or runtime dependency",
    "OneHotWidth=8 gives a focused 3-bit input to 8-bit onehot output claim",
    "smaller than prim_onehot_mux because it avoids assertion and prim_and2 dependency breadth",
    "smaller than prim_count, packer, memory, crypto, alert/esc, or broader CDC targets"
  ],
  "rejected_for_now": [
    {
      "target": "prim_onehot_mux",
      "reason": "adds assertion policy and prim_and2 mux breadth before the direct encoder claim is measured"
    },
    {
      "target": "prim_count",
      "reason": "larger hardened counter primitive has action-mask, commit, dual-counter, and assertion breadth"
    },
    {
      "target": "prim_slicer_or_packer",
      "reason": "bit-slicing and packing are useful but less directly close the onehot-family gap after onehot_check"
    },
    {
      "target": "alert_esc_or_memory_or_crypto_primitives",
      "reason": "too large for the next narrow primitive gate"
    }
  ],
  "constraints": [
