{
  "schema_version": 1,
  "gate": "tlul_fifo_sync_cpu_exact_loop_baseline",
  "target": "tlul_fifo_sync",
  "source_gpu_gate": "config/scaling_gates/tlul_fifo_sync.json",
  "source_cpu_multistate_gate": "config/scaling_gates/tlul_fifo_sync_cpu_multistate_baseline.json",
  "purpose": "Measure a single-process CPU loop for the same nstates used by the GPU scaling gate.",
  "preconditions": [
    "tlul_fifo_sync_scaling_validation passes",
    "tlul_slice_host_probe is rebuilt with --repeat-states support",
    "reports/tlul_fifo_sync_scaling_validation.json exists when CPU/GPU comparison fields are requested"
  ],
  "runs": [
    {
      "name": "single_state_cpu_exact_loop",
      "nstates": 1,
      "steps": 1,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true
    },
    {
      "name": "small_batch_cpu_exact_loop",
      "nstates": 8,
      "steps": 1,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true
    },
    {
      "name": "medium_batch_cpu_exact_loop",
      "nstates": 32,
      "steps": 1,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true
    }
  ],
  "acceptance": {
    "run_exits_zero": true,
    "each_loop_reports_constructor_ok": true,
    "each_loop_root_size_matches_gpu_storage_size": true,
    "record_elapsed_ms_and_states_per_second": true,
    "compare_against_gpu_scaling_report_when_present": true
  },
  "comparison_policy": {
    "allowed_claims": [
      "single-process CPU loop wall time for the same nstates as the GPU scaling gate",
      "GPU batched throughput from the existing scaling report",
      "CPU/GPU throughput ratio for this seed and gate shape"
    ],
    "non_claims": [
      "not a full RTL application throughput claim",
      "no target-breadth claim because only tlul_fifo_sync is exercised"
    ],
    "next_precision_step": "increase steps or add a second seed if the single-process ratio is stable enough"
  },
  "artifacts": {
    "report": "reports/tlul_fifo_sync_cpu_exact_loop_baseline.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "decide_second_seed_or_larger_workload_after_exact_cpu_loop_baseline",
  "next_action_on_fail": "diagnose_tlul_fifo_sync_cpu_exact_loop_baseline_failure"
}
