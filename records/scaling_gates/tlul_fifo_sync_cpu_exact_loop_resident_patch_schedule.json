{
  "schema_version": 1,
  "gate": "tlul_fifo_sync_cpu_exact_loop_resident_patch_schedule",
  "target": "tlul_fifo_sync",
  "source_gpu_gate": "config/scaling_gates/tlul_fifo_sync_resident_patch_schedule.json",
  "purpose": "Provide a matching CPU exact-loop baseline for the resident changing-input patch schedule gate.",
  "preconditions": [
    "reports/tlul_fifo_sync_resident_patch_schedule.json exists",
    "tlul_slice_host_probe is rebuilt with --patch-script support",
    "patch_script_lines use the same GLOBAL_OFF:BYTE, '-', and @repeat-seq grammar as the GPU resident gate"
  ],
  "runs": [
    {
      "name": "resident_patch_schedule_smoke_1x6_cpu_exact_loop",
      "nstates": 1,
      "steps": 6,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 2",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    },
    {
      "name": "resident_patch_schedule_batch_512x32_cpu_exact_loop",
      "nstates": 512,
      "steps": 32,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 15",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    }
  ],
  "acceptance": {
    "run_exits_zero": true,
    "each_loop_reports_constructor_ok": true,
    "each_loop_root_size_matches_gpu_storage_size": true,
    "record_state_steps_per_second": true,
    "compare_against_gpu_patch_schedule_report_when_present": true
  },
  "comparison_policy": {
    "allowed_claims": [
      "single-process CPU repeated eval_step wall time with byte patch script application",
      "GPU resident patch schedule throughput for this seed and gate shape",
      "CPU/GPU state-step throughput ratio for this specific changing-input gate"
    ],
    "non_claims": [
      "not a full RTL application throughput claim",
      "not broad target-breadth evidence",
      "CPU baseline applies byte patches directly to root storage and assumes global offsets match the GPU storage layout"
    ]
  },
  "artifacts": {
    "report": "reports/tlul_fifo_sync_cpu_exact_loop_resident_patch_schedule.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "compare_resident_patch_schedule_gpu_cpu_ratio",
  "next_action_on_fail": "diagnose_cpu_patch_schedule_baseline_failure"
}
