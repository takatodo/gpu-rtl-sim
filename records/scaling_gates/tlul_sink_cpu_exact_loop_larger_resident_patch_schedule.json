{
  "schema_version": 1,
  "gate": "tlul_sink_cpu_exact_loop_larger_resident_patch_schedule_envelope",
  "target": "tlul_sink",
  "source_gpu_gate": "config/scaling_gates/tlul_sink_larger_resident_patch_schedule.json",
  "source_baseline_gate": "config/scaling_gates/tlul_sink_cpu_exact_loop_resident_patch_schedule.json",
  "purpose": "Provide a matching CPU exact-loop baseline for the larger TL-UL sink resident patch schedule envelope gate.",
  "preconditions": [
    "config/scaling_gates/tlul_sink_larger_resident_patch_schedule.json is defined",
    "CPU and GPU use the same resident patch schedule script",
    "the source-backed resident patch schedule semantics remain unchanged"
  ],
  "runs": [
    {
      "name": "tlul_sink_larger_resident_patch_schedule_batch_1024x64_cpu_exact_loop",
      "nstates": 1024,
      "steps": 64,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 31",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    },
    {
      "name": "tlul_sink_larger_resident_patch_schedule_batch_2048x64_cpu_exact_loop",
      "nstates": 2048,
      "steps": 64,
      "reset_cycles": 4,
      "post_reset_cycles": 2,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 31",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    }
  ],
  "acceptance": {
    "run_exits_zero": true,
    "each_loop_reports_constructor_ok": true,
    "each_loop_root_size_matches_gpu_storage_size": true,
    "record_state_steps_per_second": true,
    "compare_against_gpu_patch_schedule_report_when_present": true
  },
  "comparison_policy": {
    "allowed_claims": [
      "single-process CPU exact-loop wall time with the same resident patch schedule semantics",
      "GPU resident schedule throughput for the same TL-UL sink larger envelope shapes",
      "CPU/GPU state-step throughput ratio for these bounded shapes"
    ],
    "non_claims": [
      "not a new target-breadth claim",
      "not full RTL application throughput",
      "not GPU-owned state construction"
    ]
  },
  "artifacts": {
    "report": "reports/tlul_sink_cpu_exact_loop_larger_resident_patch_schedule.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "run_larger_resident_schedule_envelope_gate",
  "next_action_on_fail": "diagnose_tlul_sink_cpu_larger_resident_patch_schedule_envelope"
}
