{
  "schema_version": 1,
  "gate": "tlul_sink_resident_patch_schedule_validation",
  "target": "tlul_sink",
  "source_contract": "config/resident_patch_script_semantics.json",
  "source_first_seed_gate": "config/scaling_gates/tlul_fifo_sync_resident_patch_schedule.json",
  "purpose": "Validate the resident changing-input patch schedule path on the second TL-UL seed.",
  "preconditions": [
    "tlul_sink GPU cubin is regenerated with vl_apply_patch_schedule_gpu",
    "src/hybrid/run_vl_hybrid accepts --resident-steps with --patch-script",
    "artifacts/ and reports/ are ignored generated outputs"
  ],
  "runs": [
    {
      "name": "tlul_sink_resident_patch_schedule_smoke_1x6",
      "nstates": 1,
      "steps": 1,
      "resident_steps": true,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 2",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    },
    {
      "name": "tlul_sink_resident_patch_schedule_batch_512x32",
      "nstates": 512,
      "steps": 1,
      "resident_steps": true,
      "required": true,
      "patch_script_lines": [
        "0:1",
        "-",
        "@repeat-seq 15",
        "1:2",
        "-",
        "@end-repeat-seq"
      ]
    }
  ],
  "correctness_policy": {
    "resident_gpu_runs": [
      "run exits with status 0",
      "stdout reports resident_mode: true",
      "stdout reports resident_patch_schedule",
      "dumped state byte size equals storage_size * nstates when dump is requested"
    ],
    "non_claims": [
      "no CPU/GPU speedup claim until the matching CPU patch schedule baseline passes",
      "target breadth remains limited to TL-UL seeds"
    ]
  },
  "performance_policy": {
    "record": [
      "nstates",
      "logical patch-script steps",
      "elapsed_ms",
      "state_steps_per_second"
    ],
    "non_claims": [
      "the 1x6 smoke only proves runtime wiring",
      "the 512x32 run is a second-seed validation shape, not a broad RTL claim"
    ]
  },
  "artifacts": {
    "report": "reports/tlul_sink_resident_patch_schedule.json",
    "generated_outputs_only": true
  },
  "next_action_on_pass": "run_tlul_sink_cpu_exact_loop_resident_patch_schedule",
  "next_action_on_fail": "diagnose_tlul_sink_resident_patch_schedule_failure"
}
